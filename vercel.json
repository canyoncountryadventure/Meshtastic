{
  "rewrites": [
    {
      "source": "/alerts",
      "destination": "/alerts.html"
    },
    {
      "source": "/watershed",
      "destination": "/watershed.html"
    },
    {
      "source": "/notifications",
      "destination": "/watershed-alerts.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/watershed-heartbeat",
      "schedule": "0 12 * * *"
    }
  ]
}
